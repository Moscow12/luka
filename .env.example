APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Two-Factor Authentication
# Set to true to require 2FA for untrusted devices, false for normal login only
TWO_FACTOR_ENABLED=true

# Shared-secret token for third-party sync API (employees/leaves/assets)
EXPORT_API_TOKEN=

# External Python attendance service (talks to ZKTeco/Anviz devices). Use https:// unless on localhost.
ATTENDANCE_BRIDGE_URL=
ATTENDANCE_BRIDGE_TOKEN=
ATTENDANCE_BRIDGE_TIMEOUT=200
# Optional PEM bundle if the service uses an internal CA (certificates are always verified)
ATTENDANCE_BRIDGE_CA_BUNDLE=

# SMS gateway: hosts the configured provider URLs may use (https only; subdomains allowed)
SMS_ALLOWED_HOSTS=beem.africa

# Backups: every archive entry is AES-256 encrypted with this secret (min 32 chars).
# Backups are refused while it is unset. Store a copy offline; archives cannot be restored without it.
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
BACKUP_ARCHIVE_PASSWORD=
# BACKUP_DIRECTORY=/var/backups/dasher
# BACKUP_PASSWORD_CONFIRM_SECONDS=900
